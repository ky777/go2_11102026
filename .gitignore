# Бинарные файлы программ и плагинов
*.exe
*.exe~
*.dll
*.so
*.dylib

# Тестовый бинарник, собранный с помощью "go test -c"
*.test

# Вывод утилиты go coverage
*.out
*.prof

# Зависимости (если проект не использует vendor/ по историческим причинам, 
# но модули Go хранятся в кеше; раскомментируйте vendor/ при необходимости)
# vendor/

# Рабочее пространство IDE и редакторов
.idea/
*.vscode/
*.sublime-workspace
*.sublime-project

# Системные файлы ОС
.DS_Store
Thumbs.db

.env
