@hostname=http://127.0.0.1
@port=3000

### Get  all books

GET  {{hostname}}:{{port}}/books HTTP/1.1

### Get  book by id, send right id

GET  {{hostname}}:{{port}}/books/1 HTTP/1.1

### Get  book by id,send wrong id

GET  {{hostname}}:{{port}}/books/11 HTTP/1.1

### Creat new book 

POST  {{hostname}}:{{port}}/books/ HTTP/1.1
Content-Type: application/json

{
    "id":"4",
    "title":"New good book",
    "Author":"New author"
}
### Change book by id, send right id
PUT {{hostname}}:{{port}}/books/ HTTP/1.1
Content-Type: application/json

{
    "id":"3",
    "title":"Programming C --change",
    "Author":"Брайн Керниган, Денис Ритчи --change"
}

### Change book by id,send wrong id

PUT {{hostname}}:{{port}}/books/ HTTP/1.1
Content-Type: application/json

{
    "id":"33",
    "title":"Programming C --change",
    "Author":"Брайн Керниган, Денис Ритчи --change"
}
###ID: "3", Title: "Programming C", Author: "Брайн Керниган, Денис Ритчи"},

### Delete book by id, send right id
DELETE   {{hostname}}:{{port}}/books/1 HTTP/1.1

### Delete  book by id,send wrong id

DELETE  {{hostname}}:{{port}}/books/11 HTTP/1.1

### Delete  all books

DELETE   {{hostname}}:{{port}}/books HTTP/1.1